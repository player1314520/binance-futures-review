legacy-cloud/

# 运行时产物(引擎二进制/缓存/日志),任何位置
node.exe
.runtime-data/
.cache-*.json
.last-sync.json
binance-fills-*.csv
engine.log
.node-*.part.exe
.node-*.rejected
.node-previous*.backup
resident.log

# 模板文件用 *.template.bat 命名,不受上面 START.bat/RUN.bat 规则影响(显式放行)
!scripts/desktop-kit/*.template.bat
.claude/
